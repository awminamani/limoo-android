    <View android:id="@+id/d20" android:layout_width="0dp" android:layout_weight="1" android:layout_height="6dp" android:layout_marginStart="1dp" android:background="#2A2A2A" />
    <View android:id="@+id/d21" android:layout_width="0dp" android:layout_weight="1" android:layout_height="6dp" android:layout_marginStart="1dp" android:background="#2A2A2A" />
    <View android:id="@+id/d22" android:layout_width="0dp" android:layout_weight="1" android:layout_height="6dp" android:layout_marginStart="1dp" android:background="#2A2A2A" />
    <View android:id="@+id/d23" android:layout_width="0dp" android:layout_weight="1" android:layout_height="6dp" android:layout_marginStart="1dp" android:background="#2A2A2A" />
    </LinearLayout>
</LinearLayout>
