<?xml version="1.0" encoding="utf-8"?>
<!-- Notification body.

     IMPORTANT: this layout is inflated by SystemUI, not by the app, so it may contain only platform
     widgets. A custom View class here resolves fine at build time and then fails at inflation time
     (RemoteViews cannot load app classes) - which crashed the app on connect, because the notification
     is built inside startForeground(). The dot-grid strip below is therefore a row of plain <View>
     children tinted at runtime via RemoteViews.setInt(id, "setBackgroundColor", colour).

     Android's notification renderer cannot draw the dot-matrix font either, so the counters use
     monospace; the identity comes from the flat black field, the caps and the dot strip. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#000000"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/nTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="LIMOO" />

    <TextView
        android:id="@+id/nRate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:textColor="#E5484D"
        android:letterSpacing="0.08"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:text="" />

    <TextView
        android:id="@+id/nTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:textColor="#8A8A8A"
        android:letterSpacing="0.08"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:text="" />

    <LinearLayout
        android:id="@+id/nBars"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">
    <View android:id="@+id/d0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="6dp" android:layout_marginStart="1dp" android:background="#2A2A2A" />
    <View android:id="@+id/d1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="6dp" android:layout_marginStart="1dp" android:background="#2A2A2A" />
    <View android:id="@+id/d2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="6dp" android:layout_marginStart="1dp" android:background="#2A2A2A" />
    <View android:id="@+id/d3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="6dp" android:layout_marginStart="1dp" android:background="#2A2A2A" />
    <View android:id="@+id/d4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="6dp" android:layout_marginStart="1dp" android:background="#2A2A2A" />
    <View android:id="@+id/d5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="6dp" android:layout_marginStart="1dp" android:background="#2A2A2A" />
    <View android:id="@+id/d6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="6dp" android:layout_marginStart="1dp" android:background="#2A2A2A" />
    <View android:id="@+id/d7" android:layout_width="0dp" android:layout_weight="1" android:layout_height="6dp" android:layout_marginStart="1dp" android:background="#2A2A2A" />
    <View android:id="@+id/d8" android:layout_width="0dp" android:layout_weight="1" android:layout_height="6dp" android:layout_marginStart="1dp" android:background="#2A2A2A" />
    <View android:id="@+id/d9" android:layout_width="0dp" android:layout_weight="1" android:layout_height="6dp" android:layout_marginStart="1dp" android:background="#2A2A2A" />
    <View android:id="@+id/d10" android:layout_width="0dp" android:layout_weight="1" android:layout_height="6dp" android:layout_marginStart="1dp" android:background="#2A2A2A" />
    <View android:id="@+id/d11" android:layout_width="0dp" android:layout_weight="1" android:layout_height="6dp" android:layout_marginStart="1dp" android:background="#2A2A2A" />
    <View android:id="@+id/d12" android:layout_width="0dp" android:layout_weight="1" android:layout_height="6dp" android:layout_marginStart="1dp" android:background="#2A2A2A" />
    <View android:id="@+id/d13" android:layout_width="0dp" android:layout_weight="1" android:layout_height="6dp" android:layout_marginStart="1dp" android:background="#2A2A2A" />
    <View android:id="@+id/d14" android:layout_width="0dp" android:layout_weight="1" android:layout_height="6dp" android:layout_marginStart="1dp" android:background="#2A2A2A" />
